# Godot generated files
.godot/
*.translation
export.cfg

# Native build outputs
build/
bin/
obj/
cmake-build-*/
.cache/
compile_commands.json

# Platform and editor metadata
.DS_Store
._*
*.swp
*.tmp
.worktrees/

# External card data and artwork
/data/*
!/data/.gdignore
/images/*
!/images/.gdignore

# Third-party source and local development tooling
/vendor/*
!/vendor/.gdignore
/tools/*
!/tools/.gdignore

# Node dependencies and logs
node_modules/
npm-debug.log*

# Local runtime data
/logs/
/replays/
/saves/
